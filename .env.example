# Supabase — ambil dari Supabase Dashboard → Project Settings → API.
# URL harus lengkap: https://<project-ref>.supabase.co
# Key yang dipakai HANYA anon/publishable key (aman dipakai di browser bersama RLS).
# JANGAN pernah menaruh service_role key atau secret lain di variabel NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
